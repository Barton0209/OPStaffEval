# Secrets & local runtime
.env
.env.local
*.pem
*.key

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/

# Node / frontend
**/node_modules/
**/frontend/dist/
**/.vite/

# App data (local DB, logs, backups) — remain on disk, not in Git
**/data/*.db
**/data/*.db-*
**/logs/
**/backups/
*.log

# Binaries / tunnels
**/cloudflared.exe
*.exe
!**/caddy.exe

# Excel with personal data (keep locally in Files/, do not publish)
Files/*
!Files/.gitkeep

# Android build artifacts (Capacitor sources OK; builds stay local)
**/android/**/build/
**/android/**/.gradle/
**/android/**/local.properties
**/android/**/*.apk
**/android/**/*.aab
**/android/**/captures/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Temp
tmp/
temp/
