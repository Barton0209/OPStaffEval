# =============================================================
# KingiseppApp — Environment Configuration
# =============================================================
# 1. Скопируйте этот файл в .env:
#    copy .env.example .env
# 2. Замените SECRET_KEY на сгенерированное значение:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. При необходимости измените DATABASE_URL.
# =============================================================

# --- Обязательные параметры ---
SECRET_KEY=
DATABASE_URL=sqlite:///data/kingisepp.db

# --- Опциональные параметры ---
# Хост и порт API-сервера
HOST=127.0.0.1
PORT=8000

# CORS: перечислите доверенные origin через запятую
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:8080
CORS_ORIGINS=

# Regex для динамических доменов (туннели, если разрешены)
# CORS_ORIGIN_REGEX=

# Включать ли /docs и /redoc (false для production)
EXPOSE_DOCS=false

# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_MB=10

# --- Production (VPS / VPS с HTTPS) ---
# DATABASE_URL=postgresql://user:pass@localhost/kingisepp
# CORS_ORIGINS=https://yourdomain.com
# Only these reverse-proxy IPs/CIDRs may supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1
# Required only to create ADMIN-OP on a new installation; remove after first start.
ADMIN_INITIAL_PASSWORD=
