# Kingisepp Evaluation System — Portable Edition
# Copy to .env and adjust if needed.
# НИКОГДА не используйте этот ключ в проде. Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_NAME=KingiseppApp
ORG_CODE=kingisepp
ORG_NAME=Кингисепп (ВСМ)
SECRET_KEY=CHANGE_ME__run_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=720
# DATABASE_URL=sqlite:///./data/kingisepp.db
HOST=127.0.0.1
PORT=8000
# FILES_DIR=../Files
# Явный белый список origin для CORS (web UI обслуживается тем же FastAPI — CORS ему не нужен).
# Нужен для APK (capacitor://localhost) и dev-сервера Vite.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost
# Динамические домены туннелей по маске (credentials-safe).
CORS_ORIGIN_REGEX=^https://.*\.(trycloudflare\.com|loca\.lt)$
# JWT хранится в localStorage (PWA/WebView) — httpOnly cookie НЕ используется.
# Переменные оставлены для совместимости конфигурации и выключены.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Swagger/OpenAPI выключен в проде.
EXPOSE_DOCS=false
# Максимальный размер загружаемого Excel, МБ.
MAX_UPLOAD_MB=10
# Only these reverse-proxy IPs/CIDRs may supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1
# Required only to create ADMIN-OP on a new installation; remove after first start.
ADMIN_INITIAL_PASSWORD=
