# Шаблон конфигурации подписи релизного APK.
#
# Скопируйте в keystore.properties (НЕ в git) и заполните своими значениями:
#   copy keystore.properties.example keystore.properties
#
# Файл release.keystore создаётся один раз командой:
#   keytool -genkeypair -v -keystore release.keystore -alias kingisepp \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS
#
# ХРАНИТЕ keystore.properties и release.keystore в надёжном месте.
# Потеря ключа = невозможность обновить опубликованное приложение.

# Путь к keystore относительно папки frontend/android/
storeFile=release.keystore
# Пароль хранилища (storepass)
storePassword=CHANGE_ME_STRONG_PASSWORD
# Алиас ключа
keyAlias=kingisepp
# Пароль ключа (keypass)
keyPassword=CHANGE_ME_STRONG_PASSWORD